// expect: has two handlers
// From spec/language.md 10.6: at most one handler per kind.
program p : xdp
  on short_packet { pass }
  on short_packet { drop }
{
  // the view makes the handlers reachable, so the duplicate is what
  // the program is rejected for
  let e = pkt.view<u8[4]>(0)?
  drop
}
