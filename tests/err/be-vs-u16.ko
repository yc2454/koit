// expect: compares only with a byte-order value
// From spec/language.md 8.1 and mechanisms-by-example.md M2: a
// byte-order value compares only with a byte-order value; a host-order
// constant on the other side is the mistake `htons` exists to prevent.
type EthHdr = { dst: u8[6], src: u8[6], proto: be16 }

program p : xdp
  default { drop }
{
  let eth = pkt.view<EthHdr>(0)?
  if eth.proto != 0x0800 { pass }
  drop
}
