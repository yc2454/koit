// expect: places are never compared
// From spec/language.md 7 and 18.3 (Cmp): two places are never
// compared, not even for equality.
type EthHdr = { dst: u8[6], src: u8[6], proto: be16 }

program p : xdp fail drop {
  let a = pkt.view<EthHdr>(0)?
  let b = pkt.view<EthHdr>(14)?
  if a == b { drop }
  pass
}
