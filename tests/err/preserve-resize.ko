// expect: resizes the packet, which `preserve pkt[0 .. 14)` forbids
// From spec/language.md 14.1: a program that preserves any packet
// range may not have the `resize` effect, since a resize moves every
// byte.
type EthHdr = { dst: u8[6], src: u8[6], proto: be16 }

program grow : xdp
  preserve pkt[0 .. 14)
  fail drop
{
  let eth = pkt.view<EthHdr>(0)?
  // error: the resize effect under a preserved packet range
  pkt.adjust_tail(8)?
  pass
}
