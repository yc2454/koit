// expect: not among this draft's resources
// From spec/ISSUES.md 12: section 9 allows `for x in it bounded N`
// over a map, but the resources of 11.2 include no iterator yet.
type Flow = { saddr: be32, daddr: be32 }
map tab : hash[64] of Flow -> { v: u32 }

program p : syscall {
  var acc: u32 = 0
  for (k, v) in tab bounded 4 { acc += v.v }
  return 0
}
