// expect: can fail (kind `missing`)
// From spec/language.md 10.2: a fallible expression outside the
// positions listed there is a type error; a hash lookup needs `?`,
// `else`, or `if let`.
type Flow = { saddr: be32, daddr: be32 }
map verdicts : hash[64] of Flow -> { v: u32 }
map keys : array[1] of Flow

program p : xdp fail drop {
  let key = keys[0]
  let f = verdicts[key]
  drop
}
