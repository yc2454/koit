// expect: places are never stored
// From spec/language.md 7: places are second class, never stored into
// maps or aggregates.
type EthHdr = { dst: u8[6], src: u8[6], proto: be16 }
map slots : array[1] of { off: u64 }

program p : xdp fail drop {
  let eth = pkt.view<EthHdr>(0)?
  slots[0].off = eth
  drop
}
