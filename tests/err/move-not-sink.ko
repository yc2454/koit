// expect: consuming call
// From spec/language.md 11.5: the sinks of `move` are the kernel's
// own operations; a binding is not one.
type Tuple = { saddr: be32, daddr: be32, sport: be16, dport: be16 }
map tuples : array[1] of Tuple

program p : xdp
  default { pass }
{
  let tuple = tuples[0]
  hold sk = sk_lookup_tcp(tuple)? {
    let s2 = move sk
  }
  pass
}
