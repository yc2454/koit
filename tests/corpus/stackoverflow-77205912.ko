// expect: view `ip` was invalidated by `adjust_tail`
// bpfix-empirical stackoverflow-77205912 (BPFIX-E023), a tc
// classifier: after bpf_skb_store_bytes and the checksum-replace
// helpers, which may change the packet, the old packet pointers are
// used; the verifier reports "R1 type=scalar expected=fp, pkt, ...".
// Stage 1's prelude has no store-bytes helper, so the port uses
// adjust_tail as the packet-changing helper; what the rule turns on
// is the resize effect of the row, not the helper's name.
type EthHdr  = { dst: u8[6], src: u8[6], proto: be16 }
type Ipv4Hdr = { vihl: u8, tos: u8, len: be16, id: be16, frag: be16,
                 ttl: u8, protocol: u8, csum: be16,
                 saddr: be32, daddr: be32 }

program nat : tc fail drop {
  let eth = pkt.view<EthHdr>(0)?
  let ip = pkt.view<Ipv4Hdr>(EthHdr.size)?
  let old = ip.daddr
  // the rewrite that may change the packet
  pkt.adjust_tail(0)?
  // error: the header is written through a view the helper killed
  ip.daddr = old
  pass
}
