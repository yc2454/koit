// expect: view `eth` was invalidated by `adjust_head`
// bpfix-empirical github-commit-cilium-2ff1a462cd33 (BPFIX-E001), an
// xdp program: packet data pointers are invalidated by
// bpf_xdp_adjust_head and used afterwards; the verifier reports "R7
// invalid mem access 'scalar'". In koit the view is dead after the
// resize.
type EthHdr = { dst: u8[6], src: u8[6], proto: be16 }

program cil : xdp fail drop {
  let eth = pkt.view<EthHdr>(0)?
  // room for an encapsulation header
  pkt.adjust_head(-8)?
  // error: the old view does not survive the resize; carve it again
  eth.proto = hton(0x0800)
  tx
}
