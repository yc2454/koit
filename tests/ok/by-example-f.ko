// From spec/mechanisms-by-example.md, F: handlers declared once. The
// example is a fragment; `record`, the reasons, the maps, and the
// header type are marked "not in F".

// not in F
const R_SHORT   = 1
const R_BAD_IDX = 2
const M = 16
type EthHdr = { dst: u8[6], src: u8[6], proto: be16 }
map policy  : array[1] of { cur: u32 where cur < M }
map reasons : array[4] of { n: u64 }

// not in F: the index demand r < 4 is entailed by the branch
fn record(r: u32) {
  if r < 4 { reasons[r].n += 1 }
}

program prog : xdp fail drop
  // Handlers are declared once. `reason` is what the site passed.
  on short_packet { record(R_SHORT); pass }
  on invariant    { record(reason); drop }
{
  let eth = pkt.view<EthHdr>(0)?
  let cur = policy[0].cur else fail R_BAD_IDX
  // ... (elided in F)
  tx
}
